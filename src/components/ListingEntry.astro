---
interface Props {
  title: string;
  displayDate: string;
  date: string;
  description: string;
  url: string;
  linkLabel: "Read more" | "View case study";
  linkedTitle?: boolean;
  external?: boolean;
}

const { title, displayDate, date, description, url, linkLabel, linkedTitle = false, external = true } = Astro.props;
---

<article class="entry">
  <div class="entry-heading">
    <h2>
      {linkedTitle ? <a href={url} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{title}</a> : title}
    </h2>
    <time datetime={date}>{displayDate}</time>
  </div>
  <p>{description} <a href={url} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{linkLabel}</a></p>
</article>
