---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  current?: "home" | "work" | "writeups" | "case-studies";
}

const { title, description, current = "home" } = Astro.props;
const base = import.meta.env.BASE_URL;
const route = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href={route("")} aria-current={current === "home" ? "page" : undefined}>Manish Jha</a>
      <nav aria-label="Main navigation">
        <ul>
          <li><a href={route("work/")} aria-current={current === "work" ? "page" : undefined}>Work</a></li>
          <li><a href={route("writeups/")} aria-current={current === "writeups" ? "page" : undefined}>Writeups</a></li>
          <li><a href={route("case-studies/")} aria-current={current === "case-studies" ? "page" : undefined}>Case Studies</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">© 2026 Manish Jha</footer>
  </body>
</html>

