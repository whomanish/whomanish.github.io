---
import { getCollection } from "astro:content";
import ListingEntry from "../../components/ListingEntry.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const writeups = (await getCollection("writeups")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Writeups | Manish Jha"
  description="Writeups by Manish Jha on product management, AI and building products."
  current="writeups"
>
  <h1 class="page-title">Writeups</h1>
  <section aria-label="Published writeups">
    {writeups.map(({ data }) => (
      <ListingEntry {...data} linkLabel="Read more" linkedTitle />
    ))}
  </section>
</BaseLayout>

