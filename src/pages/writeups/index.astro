---
import { getCollection } from "astro:content";
import ListingEntry from "../../components/ListingEntry.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const writeups = (await getCollection("writeups")).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Writeups | Manish Jha"
  description="Writeups by Manish Jha on product management, AI and building products."
  current="writeups"
>
  <h1 class="page-title">Writeups</h1>
  <section aria-label="Published writeups">
    {writeups.map(({ data, id }) => {
      const external = Boolean(data.url);
      const url = data.url ?? `${base}writeups/${id}/`;

      return <ListingEntry {...data} url={url} external={external} linkLabel="Read more" linkedTitle />;
    })}
  </section>
</BaseLayout>
